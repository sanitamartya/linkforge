
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

POSTGRES_USER=linkforge_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=linkforge

# API running directly on your computer
DATABASE_URL=postgresql://linkforge_user:change_this_local_password@localhost:5433/linkforge?schema=public

# API running inside Docker
DATABASE_URL_DOCKER=postgresql://linkforge_user:change_this_local_password@db:5432/linkforge?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
